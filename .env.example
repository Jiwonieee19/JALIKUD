# Copy this file to .env and fill in real values. Never commit .env.
POSTGRES_DB=jalikud
POSTGRES_USER=jalikud
POSTGRES_PASSWORD=
APP_KEY=
GHCR_TOKEN=

# PayMongo (Philippine payment gateway). secret_key is server-side only.
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
PAYMONGO_WEBHOOK_SECRET=

# --- AI chat assistant (OpenAI-compatible hosted LLM) ---
# The chat assistant calls a hosted chat-completions API. Works with OpenAI,
# Groq, OpenRouter, DeepSeek, Together, etc. Set the base URL, model and key.
# Examples:
#   OpenAI:      AI_BASE_URL=https://api.openai.com/v1        AI_MODEL=gpt-4o-mini
#   Groq:        AI_BASE_URL=https://api.groq.com/openai/v1    AI_MODEL=llama-3.3-70b-versatile
#   OpenRouter:  AI_BASE_URL=https://openrouter.ai/api/v1      AI_MODEL=openai/gpt-4o-mini
#   Gemini:      AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/  AI_MODEL=gemini-3.8-flash
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT=60

# --- Cloudflare Tunnel (exposes the Laravel API) ---
# Token from Cloudflare Zero Trust > Networks > Tunnels > your tunnel.
# Ingress routing (hostname -> http://backend:8000) is configured in the
# Cloudflare dashboard, not in docker-compose.yml.
CLOUDFLARE_TUNNEL_TOKEN=

# Optional. The cloudflared container's IP inside the compose network. It MUST
# stay in sync with TRUSTED_PROXIES below, otherwise Laravel reports the
# tunnel's IP as the client IP and every remote caller shares one rate-limit
# bucket. Only change this if it collides with the pinned IPs in
# docker-compose.yml (BACKEND_IP / FRONTEND_IP).
CLOUDFLARE_IP=172.30.0.30

# Optional override of the proxy addresses Laravel trusts for X-Forwarded-*.
# Defaults to 172.30.0.1 (docker bridge gateway), 172.30.0.20 (nginx) and
# CLOUDFLARE_IP. Only set this if you moved the container IPs above.
# TRUSTED_PROXIES=

# Public hostname of the API, so Laravel generates URLs against the tunnel.
APP_URL=

# The web app is published through ngrok running OUTSIDE Docker, e.g.
#   ngrok config add-authtoken <token>   # once
#   ngrok http 5173
# No ngrok settings are needed here.

# --- Runtime mode ---
# Defaults shown; production is the safe default because the API is reachable
# from the internet. Set APP_ENV=local / APP_DEBUG=true for local debugging.
APP_ENV=production
APP_DEBUG=false
